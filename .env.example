# VN Investment Intelligence — Environment Variables
# Copy to .env and adjust. Free baseline works without any keys.

# OpenCode (free tier models)
# OPENCODE_BIN=opencode
# OPENCODE_DEFAULT_MODEL=opencode/big-pickle
# OPENCODE_FREE_MODELS=opencode/big-pickle,opencode/mimo-v2.5-free,opencode/nemotron-3-ultra-free

# vnstock (guest mode works without key; register for higher limits)
# VNSTOCK_API_KEY=

# Database
# DATABASE_URL=sqlite:///data/invest.db

# Scheduler intervals (minutes)
# INGESTION_INTERVAL_MINUTES=60
# REEVALUATION_INTERVAL_MINUTES=120

# Paths
# DATA_DIR=data
# FUND_PDF_DIR=data/fund_pdfs
# EXPORT_DIR=data/exports